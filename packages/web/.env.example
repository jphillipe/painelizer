ANTHROPIC_API_KEY=

# Leitura por IA (S25): modelo e effort da chamada. Vazio = padrão do extract (claude-opus-5-5, effort high).
# EXTRACT_EFFORT aceita low | medium | high | xhigh | max; outro valor é ignorado. Os dois ficam gravados na
# proveniência de cada leitura ($panelizer.reading.provenance), junto com o hash do prompt.
EXTRACT_MODEL=
EXTRACT_EFFORT=

# Supabase (S22): URL do projeto e chave publicável (Project Settings › API Keys). Ver supabase/README.md.
# Sem as duas, o app roda sem login em desenvolvimento; em produção, /app fica bloqueado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# S32: chave secret do Supabase (sb_secret_…), SÓ no servidor, só para convidar por e-mail quem ainda não tem conta
# (lib/supabase/admin.ts). Vazia = o admin adiciona apenas contas já criadas no painel. Nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
